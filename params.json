{
    "_shared_pls": {
        "build_type": "pls",
        "params": {
            "n_components": 8,
            "scale": true
        }
    },
    "_shared_lgbm": {
        "build_type": "lightgbm",
        "params": {
            "n_estimators": 500,
            "learning_rate": 0.03,
            "num_leaves": 31,
            "min_child_samples": 10,
            "subsample": 0.8,
            "colsample_bytree": 0.8,
            "reg_alpha": 0.1,
            "reg_lambda": 0.1,
            "random_state": 42,
            "verbosity": -1
        }
    },
    "base_pls": {
        "extends": "_shared_pls"
    },
    "snv_pls": {
        "extends": "_shared_pls"
    },
    "snv_lgbm": {
        "extends": "_shared_lgbm"
    },
    "savgol_lgbm": {
        "extends": "_shared_lgbm"
    },
    "base_pls_snv_lgbm_residual": {
        "build_type": "residual_ensemble",
        "base_model_name": "base_pls",
        "base_preprocessor_name": "base_identity_pipeline",
        "residual_model_name": "snv_lgbm",
        "residual_preprocessor_name": "snv_lgbm_pipeline"
    }
}